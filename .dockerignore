# ============================================================================
# .dockerignore - Reduce Docker Build Context
# ============================================================================
# Files listed here are excluded from the build context sent to Docker daemon
# Reduces build time and image size by excluding unnecessary files
# ============================================================================

# ============================================================================
# BUILD ARTIFACTS & CACHES
# ============================================================================
node_modules/               # NPM dependencies (reinstalled in container)
dist/                       # Built output (recreated in container)
build/                      # Build directory
.cache/                     # Build caches
.next/                      # Next.js cache
.vite/                      # Vite cache
tsconfig.tsbuildinfo       # TypeScript build info

# ============================================================================
# ENVIRONMENT & SECRETS
# ============================================================================
.env                        # Never include real .env
.env.local                  # Local development secrets
.env.*.local                # Environment-specific local files
.env.production             # Production secrets (use CI/CD instead)
.env.*.production           # Environment-specific production files

# ============================================================================
# VERSION CONTROL
# ============================================================================
.git/                       # Git repository (not needed in container)
.gitignore                  # Git ignore rules (not needed in container)
.github/                    # GitHub specific files
.gitattributes             # Git attributes (not needed in container)

# ============================================================================
# IDE & EDITOR
# ============================================================================
.vscode/                    # VS Code settings (not needed in container)
.vscode/                    # IDE configurations
.idea/                      # IntelliJ IDE
.sublime-project            # Sublime Text
.sublime-workspace          # Sublime Text
*.swp                       # Vim swap files
*.swo                       # Vim swap files
*~                          # Backup files
.DS_Store                   # macOS metadata

# ============================================================================
# LOGS & DEBUGGING
# ============================================================================
npm-debug.log               # NPM debug logs
npm-debug.log.*             # Multiple NPM debug logs
yarn-debug.log              # Yarn debug logs
yarn-error.log              # Yarn error logs
lerna-debug.log             # Lerna logs
*.log                       # All log files
logs/                       # Log directory

# ============================================================================
# PACKAGE MANAGERS
# ============================================================================
package-lock.json           # NPM lock (includes node_modules size)
yarn.lock                   # Yarn lock file
pnpm-lock.yaml              # pnpm lock file

# ============================================================================
# DOCUMENTATION & GUIDES
# ============================================================================
README.md                   # Project readme (not needed in runtime)
CHANGELOG.md                # Change log
CONTRIBUTING.md             # Contributing guide
LICENSE                     # License file
docs/                       # Documentation files
*.md                        # All markdown files (except runtime-critical ones)

# ============================================================================
# TESTING
# ============================================================================
__tests__/                  # Test directories
tests/                      # Test directory
*.test.js                   # Test files
*.spec.js                   # Spec files
jest.config.js              # Jest configuration
vitest.config.js            # Vitest configuration
cypress/                    # Cypress tests
e2e/                        # End-to-end tests
coverage/                   # Test coverage reports

# ============================================================================
# MISC PROJECT FILES
# ============================================================================
.env.example                # Example env (safe, but not needed)
.dockerignore               # This file (not needed in container)
Dockerfile                  # Dockerfile (not needed in runtime)
docker-compose.*.yml        # Docker compose files
.editorconfig               # Editor config
.eslintignore               # ESLint ignore
.prettierignore             # Prettier ignore
.npmrc                      # NPM config
.yarnrc                     # Yarn config
Makefile                    # Build makefile
.nvmrc                      # Node version
.ruby-version               # Ruby version
.tool-versions              # Multiple tool versions

# ============================================================================
# CI/CD
# ============================================================================
.circleci/                  # CircleCI config
.travis.yml                 # Travis CI config
.github/workflows/          # GitHub Actions (already excluded via .github/)
Azure-pipelines.yml         # Azure Pipelines
.gitlab-ci.yml              # GitLab CI

# ============================================================================
# DEVELOPMENT TOOLS
# ============================================================================
.prettierrc                 # Prettier config
.eslintrc                   # ESLint config
tsconfig.json               # TypeScript config (not needed in runtime)
jsconfig.json               # JS config (not needed in runtime)
webpack.config.js           # Webpack config
tailwind.config.js          # Tailwind config (not needed in runtime)
postcss.config.js           # PostCSS config (not needed in runtime)
vite.config.js              # Vite config (not needed in runtime)

# ============================================================================
# MISC DIRECTORIES
# ============================================================================
tmp/                        # Temp directory
temp/                       # Temp directory
.tmp/                       # Hidden temp directory
out/                        # Output directory
public/                     # Public directory (optional - keep if needed)
private/                    # Private files
secrets/                    # Never include secrets directory

# ============================================================================
# SIZE OPTIMIZATION
# ============================================================================
# Optional: Uncomment to exclude if not needed for runtime
#
# public/docs/              # Documentation HTML (if not served)
# public/examples/          # Example files
# images/                   # Development images
# .notion/                  # Notion files
# sdk/                      # Internal SDK (if prebuilt)
# my-project/               # Nested projects
# primeos-notion-manager/   # External modules
# agents/                   # Agent code (optional)
