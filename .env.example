# ============================================================================
# PrimeOS Environment Variables Template
# ============================================================================
# ⚠️  SECURITY WARNING: NEVER commit secrets to this file or version control
# Use GitHub Secrets for CI/CD and .env.local (git-ignored) for local dev
# Rotate any exposed keys immediately
# ============================================================================

# ============================================================================
# 1. FRONTEND — Vite Public Variables (VITE_ prefix)
# ============================================================================
# These ARE exposed to the browser — only include public keys/URLs

VITE_APP_NAME=PrimeOS
VITE_APP_VERSION=1.0.0
VITE_APP_BASE_URL=https://primeos.primeodontologia.com.br

# Supabase (public client credentials)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
VITE_SUPABASE_STORAGE_BUCKET=primeos-prod

# Firebase (public credentials from web config)
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id

# Google Cloud (public credentials)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ============================================================================
# 2. SERVER-SIDE ONLY — Keep in .env or GitHub Secrets (NOT in .env.example)
# ============================================================================
# These are NEVER exposed to the browser
# Fill these in .env.local for local dev or GitHub Secrets for CI/CD

# Hostinger API Integration
# Get from: https://developers.hostinger.com (API tokens section)
HOSTINGER_API_TOKEN=your-hostinger-api-token

# Internal API Security
# Generate: `openssl rand -base64 32`
PRIMEOS_API_KEY=your-internal-api-secret-key

# GitHub Integration (for automated deploys)
# Get from: GitHub Settings → Developer settings → Personal access tokens
# Requires: repo:write, actions:write scopes
GITHUB_TOKEN=your-github-pat-token
GITHUB_REPO=PrimeOsHub/primeos

# Supabase Server-Side (Service Role — never expose to frontend)
# Get from: Supabase Dashboard → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Supabase Direct Database Access (PostgreSQL)
# For migrations and scripts only — NOT for application code
SUPABASE_DB_PASSWORD=your-supabase-db-password
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Firebase Admin SDK (Server-side only)
# Get from: Firebase Console → Project Settings → Service Accounts
# Download JSON key and extract values
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com

# OpenAI API (for AI features)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-openai-api-key

# Google OAuth2 Server-Side (if using Google Sign-In)
# Get from: Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Notion Integration (if using Notion as CMS)
# Get from: Notion API Dashboard
NOTION_TOKEN=your-notion-integration-token
NOTION_DB_ID=your-notion-database-id

# ============================================================================
# 3. LOCAL DEPLOYMENT — Hostinger FTP (only needed for local `npm run deploy`)
# ============================================================================
# These are for the scripts/deploy.mjs script to upload files via FTP
# REQUIRED: FTP credentials from Hostinger
# Get from: Hostinger Control Panel → FTP Accounts

FTP_USER=your-ftp-username
FTP_PASSWORD=your-ftp-password
FTP_HOST=ftp.primeodontologia.com.br
FTP_PORT=21
FTP_REMOTE_ROOT=/public_html

# ============================================================================
# 4. DEVELOPMENT & DEBUGGING
# ============================================================================

# Enable verbose logging (for troubleshooting)
DEBUG=false

# Build target environment
NODE_ENV=development

# ============================================================================
# SETUP INSTRUCTIONS
# ============================================================================
#
# For LOCAL DEVELOPMENT:
# 1. Copy this file: cp .env.example .env.local
# 2. Fill in all variables (especially server-side ones)
# 3. Keep .env.local in .gitignore (never commit secrets)
#
# For CI/CD / GitHub Actions:
# 1. Go to: GitHub repo → Settings → Secrets and variables → Actions
# 2. Add each variable as a GitHub Secret
# 3. Reference in workflows: ${{ secrets.VARIABLE_NAME }}
#
# For Firebase Hosting:
# 1. Update .firebaserc with your Firebase project ID
# 2. Run: firebase login && firebase deploy
#
# For Hostinger FTP Deploy:
# 1. Fill in FTP_* variables above
# 2. Run: npm run deploy:hostinger
#
# Security Checklist:
# ✅ Never commit real keys to version control
# ✅ Rotate keys if accidentally exposed
# ✅ Use separate keys for dev/staging/production
# ✅ Review GitHub Secrets regularly
# ✅ Keep .env and .env.local in .gitignore
#
# ============================================================================

