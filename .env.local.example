# PrimeOS - FTP Deployment Configuration
# NEVER commit this file - it contains secrets
# Copy this to .env.local and add your credentials

# ============================================================================
# FTP Configuration (Hostinger)
# ============================================================================

# FTP Server Details
FTP_USERNAME=u188684587
FTP_PASSWORD=your_password_here
FTP_SERVER=89.117.7.117
FTP_PORT=21

# Remote Directory - SAFE SUBDIRECTORY ONLY
# ✅ CORRECT: Points to primeos subdomain only
FTP_REMOTE_DIR=/public_html/primeos

# Delete Remote Files - LEAVE UNSET (never true)
# ❌ DO NOT ENABLE: This would delete all remote files before upload
# FTP_DELETE_REMOTE=false  (do not set at all)

# ============================================================================
# Supabase Configuration (if needed)
# ============================================================================

VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ============================================================================
# Other Configuration
# ============================================================================

VITE_PRIMEOS_APP_BASE_URL=https://primeos.primeodontologia.com.br

# ============================================================================
# IMPORTANT SECURITY NOTES
# ============================================================================
# 1. NEVER commit this file to git
# 2. Add .env.local to .gitignore (already done)
# 3. Always use safe paths: /public_html/primeos (not /public_html)
# 4. Never set FTP_DELETE_REMOTE=true
# 5. Verify FTP credentials are correct before first deploy
# 6. Test with "npm run preview" before deployment

# ============================================================================
# Setup Instructions
# ============================================================================
# 1. Copy this file to .env.local
# 2. Add your FTP password: FTP_PASSWORD=your_actual_password
# 3. Save (do not commit)
# 4. Run: npm run build:primeos && npm run deploy:hostinger
