#!/bin/sh
# Pre-commit hook: Prevent committing dangerous FTP configurations

echo "🔒 Running deployment safety checks..."

# Check for dangerous deleteRemote setting in FtpDeploy.mjs
if git diff --cached scripts/FtpDeploy.mjs | grep -q "deleteRemote.*true"; then
  echo ""
  echo "❌ BLOCKED: Attempting to commit deleteRemote: true"
  echo ""
  echo "This setting will DELETE ALL FILES on the remote server."
  echo "If you truly need this, remove the .husky/pre-commit hook."
  echo ""
  exit 1
fi

# Check for dangerous /public_html root (without /primeos subdirectory)
if git diff --cached scripts/FtpDeploy.mjs | grep -E "remoteRoot.*['\"]\/public_html['\"]"; then
  echo ""
  echo "❌ BLOCKED: Attempting to commit /public_html as remoteRoot"
  echo ""
  echo "This is the root directory and will DELETE THE ENTIRE WEBSITE."
  echo "Use /public_html/primeos instead."
  echo ""
  exit 1
fi

# Check for secrets in .env files (if accidentally added)
if git diff --cached | grep -E "FTP_PASSWORD|FTP_USERNAME" | grep -v ".env.example"; then
  echo ""
  echo "⚠️  WARNING: Secrets detected in staged changes"
  echo ""
  echo "Make sure you're not committing .env or secrets to git!"
  echo "These should only be in .env.local or .gitignore"
  echo ""
  # Don't block, just warn - continue with exit 0
fi

echo "✅ Safety checks passed"
exit 0
