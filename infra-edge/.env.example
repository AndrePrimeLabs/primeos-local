# ═══════════════════════════════════════════════════════════════
# PrimeOsHub — Environment Variables Template
# Copy to .env and fill in all values before running
# NEVER commit .env to git — it is in .gitignore
# ═══════════════════════════════════════════════════════════════

# ── Registry & Versioning ────────────────────────────────────
REGISTRY=ghcr.io/primeos
TAG=latest

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=primeos
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=primeos_db

# ── Redis ────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ── Auth ─────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_256_BIT_RANDOM_STRING
JWT_EXPIRES_IN=7d
INTERNAL_API_KEY=CHANGE_ME_INTERNAL_SERVICE_KEY

# ── Anthropic (Claude AI) ────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME

# ── WhatsApp Business API ────────────────────────────────────
WHATSAPP_TOKEN=CHANGE_ME_META_ACCESS_TOKEN
WHATSAPP_PHONE_ID=CHANGE_ME_PHONE_NUMBER_ID
WHATSAPP_VERIFY_TOKEN=CHANGE_ME_WEBHOOK_VERIFY_TOKEN

# ── Integrations ─────────────────────────────────────────────
GITHUB_TOKEN=ghp_CHANGE_ME
NOTION_TOKEN=ntn_CHANGE_ME
NETLIFY_TOKEN=CHANGE_ME_NETLIFY_PAT

# ── Monitoring ───────────────────────────────────────────────
GRAFANA_PASSWORD=CHANGE_ME_GRAFANA_ADMIN
GRAFANA_URL=http://localhost:3030

# ── Luzia Governance ─────────────────────────────────────────
LUZIA_ALERT_WEBHOOK=https://hooks.slack.com/CHANGE_ME
GOVERNANCE_INTERVAL_MS=60000

# ── App Config ───────────────────────────────────────────────
API_URL=https://your-domain.com/api
WS_URL=wss://your-domain.com/ws
CORS_ORIGINS=https://your-domain.com
LOG_LEVEL=info
